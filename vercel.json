{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "./",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel-api"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "api" } }
  ],
  "daemons": {
    "whatsapp": {
      "root": "./",
      "entrypoint": "Dockerfile.vercel-daemon",
      "instances": { "iad1": 1 },
      "resources": { "requests": { "memory": "2Gi" } },
      "livenessProbe": {
        "httpGet": { "port": 8080, "path": "/_bridge/health" },
        "initialDelaySeconds": 30,
        "periodSeconds": 15,
        "timeoutSeconds": 3
      },
      "terminationGracePeriodSeconds": 60
    }
  }
}
