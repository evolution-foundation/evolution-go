# Production-only secrets: configure in Vercel project Settings -> Environment Variables.
# Both services see these variables. NEVER commit actual passwords or API keys.
# Set the Supabase direct connection on port 5432; use an IPv4-capable direct endpoint
# if Vercel cannot reach the provided Supabase address.
# One Supabase database, isolated schemas via PostgreSQL search_path:
POSTGRES_AUTH_DB=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require&options=-csearch_path%3Devo_auth
POSTGRES_USERS_DB=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require&options=-csearch_path%3Devo_app
GLOBAL_API_KEY=GENERATE_A_LONG_RANDOM_SECRET
DATABASE_SAVE_MESSAGES=false
CLIENT_NAME=evolution
CONNECT_ON_STARTUP=true
SERVER_PORT=8080
WADEBUG=INFO
LOGTYPE=console
AMQP_GLOBAL_ENABLED=false
NATS_GLOBAL_ENABLED=false
MINIO_ENABLED=false
# License registration is required by upstream; after initial registration,
# this enables headless activation on subsequent starts:
# EVOLUTION_OPERATOR_EMAIL=
# Browser Manager, passkey endpoint, streaming, and S3 media are not proxied in phase 1.
